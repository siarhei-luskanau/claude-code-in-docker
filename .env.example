# Copy to .env, then: chmod 600 .env
# Get the token by running `claude setup-token` on the macOS host.
CLAUDE_CODE_OAUTH_TOKEN=

# Extra apt packages to install on every launch, space-separated (e.g. "jq ripgrep").
EXTRA_APT_PACKAGES=

# Set to 1 to skip apt installs entirely (fastest start; git will be unavailable).
SKIP_APT=0
